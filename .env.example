# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to GitHub!

# ── Hardhat (deploy / verify) ────────────────────────────

# Your wallet's private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Get a free API key from https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key_here

# ── Frontend build (Vite) ────────────────────────────────
# Optional. Used only when you rebuild the frontend locally.
# Vite env vars are baked into the static build (prefix: VITE_).

# WalletConnect project ID — enables the WalletConnect (mobile QR) connector.
# Get a free one at https://cloud.walletconnect.com
# When omitted, the WalletConnect option is hidden; all injected wallets still work.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional. Overrides the on-chain contract address used by the frontend.
# Leave empty to use the deployed HelloBase address baked into src/lib/contract.ts.
VITE_CONTRACT_ADDRESS=